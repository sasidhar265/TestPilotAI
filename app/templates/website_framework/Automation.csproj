<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Website.Automation</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/Reqnroll/Automation.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="Selenium.WebDriver" Version="4.48.0" />
    <PackageReference Include="Selenium.Support" Version="4.48.0" />
    <PackageReference Include="DotNetSeleniumExtras.PageObjects.Core" Version="4.48.0" />
    <Content Include="Input/*.Json" CopyToOutputDirectory="PreserveNewest" TargetPath="Input/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
