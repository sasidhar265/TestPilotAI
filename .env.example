# Optional. Leave blank to use the identity saved by `copilot login`.
# For non-interactive use, set a supported Copilot user token here.
COPILOT_GITHUB_TOKEN=

# Optional. Blank lets GitHub Copilot select the account's default model.
COPILOT_MODEL=
AGENT_PROFILE=auto-finance-quotation
COPILOT_TIMEOUT_SECONDS=300
# Total budget for the QA Master tool loop. This must exceed the individual timeout because a
# governed both-route may run automation, revision, manual generation, validation, and storage.
COPILOT_COORDINATOR_TIMEOUT_SECONDS=1800

# OpenAI API fallback. ChatGPT subscriptions and API billing are separate, so this route requires
# a Platform API key. The Codex route below can reuse a locally signed-in ChatGPT/Codex account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=300

# Codex CLI fallback. Run `codex login`, then confirm with `codex login status`.
CODEX_EXECUTABLE=codex
# Blank uses the model selected by the signed-in Codex account/configuration.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=300
# C# artifacts can contain many files; keep their generation budget separate from suite generation.
CODEX_ARTIFACT_TIMEOUT_SECONDS=900

# Production API protection. Generate at least 32 random characters and provide the value through
# the deployment secret manager. API clients send: Authorization: Bearer <token>.
API_AUTH_TOKEN=

# Optional browser login. Configure both values to protect the UI with a signed HttpOnly session.
APP_USERNAME=admin
APP_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Optional view-only guest entry until an absolute timestamp with timezone.
# Example: 2026-10-07T23:59:00+01:00. Empty disables guest entry.
TEMPORARY_GUEST_ACCESS_UNTIL=

# Comma-separated Host header allowlist. Use explicit public/internal hostnames in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Resource bounds. The request limit includes multipart framing and must exceed the upload limit.
MAX_REQUEST_BODY_BYTES=16777216
MAX_UPLOAD_BYTES=15728640
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_GENERATIONS=2
REQUEST_QUEUE_TIMEOUT_SECONDS=2
# Disable on memory-constrained hosted instances to avoid a resident Copilot coordinator process.
MODEL_DIRECTED_RUNTIME_ENABLED=true

# Repository-local exact-match cache. Keep the database out of source control.
ORGANIZATIONAL_MEMORY_ENABLED=true
ORGANIZATIONAL_MEMORY_PATH=.agent-memory/test_suites.db

# Fixed server-side destination for explicitly accepted test-design artifacts.
ACCEPTED_OUTPUT_DIRECTORY=output

# Jira Cloud base URL, for example https://your-company.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional comma-separated custom-field IDs or exact names; fields named
# "Acceptance Criteria" are discovered automatically.
JIRA_ACCEPTANCE_CRITERIA_FIELDS=
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true

# Optional full name used for the profile name and first/last initials.
APP_DISPLAY_NAME=

# Persist this file on durable storage in hosted deployments.
USER_DATABASE_PATH=.agent-memory/users.db

# Optional Gemini test-generation provider (server-side credentials only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=300

# Local repository BDD reporting (Allure 2 CLI and Java must be installed).
ALLURE_EXECUTABLE=allure
ALLURE_TIMEOUT_SECONDS=120

# Stage 5: reviewed ReqnRoll pack and its target API (also accepted as environment variables)
AUTOMATION_PROJECT_PATH=automation/QualityLifecycle.Automation.csproj
API_BASE_URL=
API_BEARER_TOKEN=
API_FIXTURE_FILE=
API_REQUEST_METHOD=
API_REQUEST_PATH=

# Optional Microsoft User Secrets for local development only.
# Enable here for the Python app, or export USER_SECRETS_ENABLED=true for direct dotnet test.
# Precedence: explicit settings > environment variables > User Secrets > .env > defaults.
USER_SECRETS_ENABLED=false
USER_SECRETS_ID=quality-lifecycle-studio-local
# Optional workspace URL for local BDD; defaults to http://127.0.0.1:${PORT:-8000}.
QUALITY_LIFECYCLE_BASE_URL=
