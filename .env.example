# Optional. Leave blank to use the identity saved by `copilot login`.
# For non-interactive use, set a supported Copilot user token here.
COPILOT_GITHUB_TOKEN=

# Optional. Blank lets GitHub Copilot select the account's default model.
COPILOT_MODEL=
AGENT_PROFILE=auto-finance-quotation
COPILOT_TIMEOUT_SECONDS=300
# Total budget for the QA Master tool loop. This must exceed the individual timeout because a
# governed both-route may run automation, revision, manual generation, validation, and storage.
COPILOT_COORDINATOR_TIMEOUT_SECONDS=1800

# Production API protection. Generate at least 32 random characters and provide the value through
# the deployment secret manager. API clients send: Authorization: Bearer <token>.
API_AUTH_TOKEN=

# Optional browser login. Configure both values to protect the UI with a signed HttpOnly session.
APP_USERNAME=admin
APP_PASSWORD=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# Comma-separated Host header allowlist. Use explicit public/internal hostnames in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Resource bounds. The request limit includes multipart framing and must exceed the upload limit.
MAX_REQUEST_BODY_BYTES=16777216
MAX_UPLOAD_BYTES=15728640
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_GENERATIONS=2
REQUEST_QUEUE_TIMEOUT_SECONDS=2

# Repository-local exact-match cache. Keep the database out of source control.
ORGANIZATIONAL_MEMORY_ENABLED=true
ORGANIZATIONAL_MEMORY_PATH=.agent-memory/test_suites.db

# Fixed server-side destination for explicitly accepted test-design artifacts.
ACCEPTED_OUTPUT_DIRECTORY=output

# Jira Cloud base URL, for example https://your-company.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional comma-separated custom-field IDs or exact names; fields named
# "Acceptance Criteria" are discovered automatically.
JIRA_ACCEPTANCE_CRITERIA_FIELDS=
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true
